{
  "name": "parsi-rtl",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome/Firefox MV3 extension: correct direction and typography for right-to-left text on any website.",
  "scripts": {
    "test": "node --test",
    "test:behaviour": "'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' --headless --disable-gpu --virtual-time-budget=10000 --dump-dom test/visual/toggle.html 2>/dev/null | grep -o '<title>[^<]*</title>'",
    "render:fixture": "'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' --headless --disable-gpu --hide-scrollbars --window-size=1000,460 --screenshot=test/visual/cascade.png test/visual/cascade.html",
    "render:shots": "node tools/render-shots.mjs",
    "package": "npm run package:chrome && npm run package:firefox",
    "package:chrome": "rm -f \"$HOME/Downloads/parsi-rtl-$npm_package_version-chrome.zip\" && zip -r \"$HOME/Downloads/parsi-rtl-$npm_package_version-chrome.zip\" manifest.json src -x '*.DS_Store' && echo \"→ $HOME/Downloads/parsi-rtl-$npm_package_version-chrome.zip\"",
    "package:firefox": "npm run stage:firefox && rm -f \"$HOME/Downloads/parsi-rtl-$npm_package_version-firefox.zip\" && (cd build/firefox && zip -r \"$HOME/Downloads/parsi-rtl-$npm_package_version-firefox.zip\" . -x '*.DS_Store') && echo \"→ $HOME/Downloads/parsi-rtl-$npm_package_version-firefox.zip\"",
    "lint:md": "markdownlint --config .markdownlint.json README.md 'docs/**/*.md' CHANGELOG.md PRIVACY.md",
    "sync:version": "node tools/sync-version.mjs",
    "stage:firefox": "node tools/stage-firefox.mjs",
    "lint:ext": "npm run stage:firefox && web-ext lint --source-dir=build/firefox",
    "sign:firefox": "npm run stage:firefox && web-ext sign --channel=listed --source-dir=build/firefox --artifacts-dir=\"$HOME/Downloads\""
  },
  "homepage": "https://github.com/su6i/parsi-rtl",
  "license": "MIT",
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "web-ext": "^10.6.0"
  }
}
